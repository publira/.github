{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // config:best-practices enables no customManagers preset, so `# renovate:`-annotated
  // `*_VERSION` pins go stale. Both presets match only on that annotation.
  extends: [
    "config:best-practices",
    // Dockerfile
    "customManagers:dockerfileVersions",
    // GitHub Actions workflows
    "customManagers:githubActionsVersions",
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update annotated version variables in shell scripts",
      managerFilePatterns: ["/(^|/)[^/]+\\.sh$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z.-]+)\\s+depName=(?<depName>\\S+?)(?:\\s+packageName=(?<packageName>\\S+?))?(?:\\s+versioning=(?<versioning>\\S+?))?(?:\\s+extractVersion=(?<extractVersion>\\S+?))?\\s+(?:readonly\\s+)?(?:export\\s+)?[A-Za-z_][A-Za-z0-9_]*_VERSION=[\\\"']?(?<currentValue>[^\\\"'\\s]+)[\\\"']?",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      customType: "regex",
      // The devcontainer manager updates a Feature's reference but not the tool
      // versions passed to it as options (for example `version` and `tflint` of
      // the Terraform Feature), so such an option is annotated with a
      // `// renovate:` comment on the line above it, in the same format as the
      // shell script annotations.
      description: "Update annotated tool versions passed as Dev Container Feature options",
      managerFilePatterns: [
        "/(^|/)\\.devcontainer(/[^/]+)?/devcontainer\\.json$/",
        "/(^|/)\\.devcontainer\\.json$/",
      ],
      matchStrings: [
        '//\\s*renovate:\\s*datasource=(?<datasource>[a-z.-]+)\\s+depName=(?<depName>\\S+?)(?:\\s+packageName=(?<packageName>\\S+?))?(?:\\s+versioning=(?<versioning>\\S+?))?(?:\\s+extractVersion=(?<extractVersion>\\S+?))?\\s+"[A-Za-z0-9_]+":\\s*"(?<currentValue>[^"]+)"',
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    },
    {
      customType: "regex",
      // The npm manager does not read `devEngines` yet
      // (renovatebot/renovate#38067), so a repository that pins Node.js there
      // — where `pnpm/setup` reads it — would stop receiving updates for it.
      // A repository without `devEngines.runtime` matches nothing and is
      // unaffected.
      //
      // The lock file stays in step: the npm manager derives the lock files to
      // regenerate from the paths of the updated package files rather than from
      // the manager that updated them, so a lock file recording the runtime is
      // rebuilt in the same branch.
      description: "Update the Node.js runtime pinned in package.json devEngines",
      managerFilePatterns: ["/(^|/)package\\.json$/"],
      matchStrings: [
        '"runtime":\\s*\\{[^}]*"name":\\s*"node",\\s*"version":\\s*"(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: "node-version",
      depNameTemplate: "node",
    },
    {
      customType: "regex",
      // distroless publishes no versioned tags: the Node.js major is part of
      // the image name, which the docker datasource never moves. Bound to the
      // `node` dependency, the major moves with the Node.js major update, and
      // the digest of the new image comes from the `distroless-nodejs`
      // datasource below with the release, so one line moves both.
      description: "Move the Node.js major and the digest of the distroless runner image in a Dockerfile with the Node.js major update",
      managerFilePatterns: [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
      ],
      matchStrings: [
        "gcr\\.io/distroless/nodejs(?<currentValue>\\d+)-debian13:nonroot@sha256:[0-9a-f]{64}",
      ],
      autoReplaceStringTemplate: "gcr.io/distroless/nodejs{{{newValue}}}-debian13:nonroot@{{{newDigest}}}",
      datasourceTemplate: "custom.distroless-nodejs",
      depNameTemplate: "node",
      // Renovate caches a datasource response by package name, and the
      // response depends on the current major, so the package is the image.
      packageNameTemplate: "gcr.io/distroless/nodejs{{{currentValue}}}-debian13",
      versioningTemplate: "node",
    },
    {
      customType: "regex",
      // buf has no Renovate manager. A remote plugin is looked up on the Buf
      // Schema Registry itself rather than on the Go module or npm package it
      // is built from: the registry publishes a plugin hours to days after
      // that release, and `buf generate` rejects a version it has not
      // published yet.
      description: "Update Buf Schema Registry remote plugin versions in buf.gen.yaml",
      managerFilePatterns: ["/(^|/)buf\\.gen\\.yaml$/"],
      matchStrings: [
        "remote:\\s*(?<depName>buf\\.build/[^/\\s]+/[^:\\s]+):(?<currentValue>v[^\\s#]+)",
      ],
      datasourceTemplate: "custom.buf-plugin",
    },
  ],
  customDatasources: {
    // GetLatestCuratedPlugin returns the newest version the registry serves
    // for a plugin, and only that one, which is all a pin needs to be raised
    // to. It is sent as a Connect GET request because a custom datasource can
    // only fetch a URL. `packageName` is the plugin as buf.gen.yaml names it,
    // `buf.build/<owner>/<name>`.
    "buf-plugin": {
      defaultRegistryUrlTemplate: "https://buf.build/buf.alpha.registry.v1alpha1.PluginCurationService/GetLatestCuratedPlugin?encoding=json&message=%7B%22owner%22%3A%22{{{replace '^buf[.]build/([^/]+)/.*$' '$1' packageName}}}%22%2C%22name%22%3A%22{{{replace '^buf[.]build/[^/]+/' '' packageName}}}%22%7D",
      transformTemplates: [
        '{"releases": [{"version": plugin.version, "releaseTimestamp": plugin.createTime}], "sourceUrl": plugin.sourceUrl}',
      ],
    },
    // The digest of a distroless Node.js image lives in the registry
    // repository of its major, and a lookup fetches one URL, so the URL names
    // the next LTS major's repository and the response is its tag list
    // (empty, not 404, before the image exists). The next LTS major is 26
    // after 24, then every major, since every release line is promoted to LTS
    // from Node.js 27 on. The release is `<major>.0.0`, which node versioning
    // rates stable from the major's LTS date like the other `node` pins, and
    // carries the `nonroot` digest. The current major is listed without one
    // so the lookup always resolves. Extend the chain before Node.js 36.
    "distroless-nodejs": {
      defaultRegistryUrlTemplate: "https://gcr.io/v2/distroless/nodejs{{{replace '^24$' '26' (replace '^26$' '27' (replace '^27$' '28' (replace '^28$' '29' (replace '^29$' '30' (replace '^30$' '31' (replace '^31$' '32' (replace '^32$' '33' (replace '^33$' '34' (replace '^34$' '35' (replace '^35$' '36' currentValue))))))))))}}}-debian13/tags/list",
      transformTemplates: [
        '{"releases": $append([{"version": "{{{currentValue}}}.0.0"}], $each(manifest, function($m, $digest) { "nonroot" in $m.tag ? {"version": $replace(name, /^distroless\\/nodejs(\\d+)-debian13$/, "$1") & ".0.0", "digest": $digest, "releaseTimestamp": $fromMillis($number($m.timeUploadedMs))} }))}',
      ],
    },
  },
  // One hidden comment per update at the top of each pull request body. The
  // maintenance bot in publira/agents approves a Renovate pull request when a
  // maintainer already approved and merged the same update in another
  // repository, and "the same" has to mean the same manager, datasource,
  // dependency, from- and to-version, digests, and update type. Nothing
  // Renovate writes by default carries all of them: the title has no
  // from-version, the branch name no version at all, the table never names the
  // manager and shows the update type or full digests only in some pull
  // requests, and the existing renovate-debug comment holds only Renovate's
  // version, the target branch, and labels. So Renovate writes them here, from
  // the same values it used for the update.
  //
  // The payload is the update's JSON in Base64, so no markdown or emoji
  // processing changes it. The bot reads only the comments that open the body,
  // ahead of anything copied from release notes, and refuses a field it does
  // not know, so change the fields here and in the bot together. A repository
  // that sets its own prHeader replaces this one and gets no automatic
  // approvals.
  prHeader: "{{#each upgrades}}<!-- publira-renovate-update {{{encodeBase64 (toJSON (toObject 'manager' manager 'datasource' datasource 'depName' depName 'packageName' packageName 'currentVersion' currentVersion 'newVersion' newVersion 'currentDigest' currentDigest 'newDigest' newDigest 'updateType' updateType))}}} -->\n{{/each}}",
  // Chachamaru in publira/agents commits to Renovate's branches and commits
  // again after Renovate rewrites them, so its commits must not stop Renovate
  // from updating the branch.
  gitIgnoredAuthors: ["337675973+chachamaru-bot[bot]@users.noreply.github.com"],
  postUpdateOptions: ["gomodTidy", "npmDedupe", "pnpmDedupe"],
  // Flutter-related ignores (shared by consumer repos; do not re-declare locally):
  // - SDK exact pins: advance only by upgrading the Flutter SDK.
  // - flutter-plugin-loader: Gradle plugin id, not a versioned registry dep.
  ignoreDeps: [
    "characters",
    "dev.flutter.flutter-plugin-loader",
    "matcher",
    "meta",
    "test_api",
    "vector_math",
  ],
  // Group monorepo-style deps that Renovate's monorepo presets do not cover
  // (complements group:monorepos from config:best-practices). A Buf Schema
  // Registry plugin joins the group of the runtime library its generated code
  // is compiled against: a release the registry has already published arrives
  // in one pull request with the library, and a plugin published later
  // follows in a pull request of its own.
  packageRules: [
    // connect-es (https://github.com/connectrpc/connect-es)
    {
      groupName: "connect-es monorepo",
      matchDatasources: ["custom.buf-plugin", "npm"],
      matchPackageNames: ["@connectrpc/**", "buf.build/connectrpc/es"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // connect-go (https://github.com/connectrpc/connect-go)
    {
      groupName: "connect-go monorepo",
      matchDatasources: ["custom.buf-plugin", "go"],
      matchPackageNames: ["buf.build/connectrpc/go", "connectrpc.com/**"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // protobuf.dart (https://github.com/google/protobuf.dart). Matched by name
    // because the plugin (v25.x) and runtime (6.x) version lines differ, and
    // the repository's other pub packages must stay out of the group.
    {
      groupName: "protobuf.dart",
      matchDatasources: ["custom.buf-plugin", "dart"],
      matchPackageNames: ["buf.build/protocolbuffers/dart", "protobuf"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // protobuf-es (https://github.com/bufbuild/protobuf-es)
    {
      groupName: "protobuf-es monorepo",
      matchDatasources: ["custom.buf-plugin", "npm"],
      matchPackageNames: ["@bufbuild/**", "buf.build/bufbuild/es"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // protobuf-go (https://github.com/protocolbuffers/protobuf-go)
    {
      groupName: "protobuf-go",
      matchDatasources: ["custom.buf-plugin", "go"],
      matchPackageNames: [
        "buf.build/protocolbuffers/go",
        "google.golang.org/protobuf",
      ],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // sugar-high (https://github.com/huozhi/sugar-high)
    {
      groupName: "sugar-high monorepo",
      matchDatasources: ["npm"],
      matchPackageNames: ["sugar-high", "@sugar-high/**"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // FlutterFire: each release pins firebase-ios-sdk exactly. Matched by source
    // URL because firebase_ui_* comes from firebase/FirebaseUI-Flutter.
    {
      groupName: "flutterfire monorepo",
      matchDatasources: ["dart"],
      matchSourceUrls: ["https://github.com/firebase/flutterfire"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // oxc, ultracite, and the configs and plugins oxlint loads all change what
    // `ultracite check` accepts.
    {
      groupName: "lint toolchain",
      matchDatasources: ["npm"],
      matchPackageNames: [
        "@*/eslint-plugin",
        "@*/eslint-plugin-*",
        "@*/oxlint-config",
        "@*/oxlint-config-*",
        "@*/oxlint-plugin",
        "@*/oxlint-plugin-*",
        "@oxfmt/**",
        "@oxlint/**",
        "eslint-plugin-*",
        "oxfmt",
        "oxlint",
        "oxlint-config-*",
        "oxlint-plugin-*",
        "ultracite",
      ],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // golang-migrate is consumed as both a Go module and a released CLI
    // binary, so the library and the pinned CLI version reach Renovate through
    // different datasources and would otherwise be raised as two Pull Requests
    // for the same upstream release.
    {
      groupName: "golang-migrate",
      matchDatasources: ["github-releases", "go"],
      matchPackageNames: [
        "github.com/golang-migrate/migrate/**",
        "golang-migrate/migrate",
      ],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // The image has to move with the npm packages, but reports no source URL
    // for group:monorepos to match.
    {
      groupName: "playwright monorepo",
      matchDatasources: ["docker"],
      matchPackageNames: ["mcr.microsoft.com/playwright"],
      matchUpdateTypes: ["digest", "patch", "minor", "major"],
    },
    // The image has no release timestamp to wait on, and a group drops its
    // pending upgrades, so the npm half must not wait either.
    {
      description: "Raise updates of the npm packages released from microsoft/playwright as soon as they are published.",
      matchDatasources: ["npm"],
      matchSourceUrls: ["https://github.com/microsoft/playwright"],
      minimumReleaseAge: null,
    },
    // Base images are published under a new calendar tag and can also be rebuilt
    // under a tag that already exists. The docker datasource puts a tag update
    // and a digest update of the current tag on different branches, so both
    // open a pull request for the same line and the digest one is autoclosed
    // once the tag update is merged. Keying the branch by image alone puts both
    // on one branch, where Renovate keeps the update listed first (the tag
    // update) and drops the other as an upgrade collision; a rebuild with no
    // newer tag still arrives as a digest update. That ordering is Renovate's
    // implementation rather than documented behavior. `groupName` is not used
    // because it would put every image in the namespace on one branch.
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/publira/base-images/**"],
      branchTopic: "{{{depNameSanitized}}}",
    },
    // Renovate keeps the digest a release carries only for a dependency it
    // pins. The line's own digest is not captured: Renovate would then look
    // for a digest update of the current image, which this datasource cannot
    // return, and warn on every run.
    {
      description: "Carry the digest of the distroless runner image into the Node.js major update.",
      matchDatasources: ["custom.distroless-nodejs"],
      pinDigests: true,
    },
    // pubspec.lock must be resolved with the project's Flutter SDK.
    {
      description: "Disable pub lockFileMaintenance so Renovate does not rewrite SDK-pinned transitives (which flutter pub get then reverts).",
      matchManagers: ["pub"],
      matchUpdateTypes: ["lockFileMaintenance"],
      enabled: false,
    },
    // `replace` turns `>=5.1.1 <7.0.0` into `<8.0.0`, and `widen` turns a
    // caret range into `^1.0.0 || ^2.0.0`, which pub rejects.
    {
      description: "Widen `>=x <y` pub constraints instead of replacing them.",
      matchManagers: ["pub"],
      matchCurrentValue: "/^>=\\S+ <\\S+$/",
      rangeStrategy: "widen",
    },
    // config:best-practices holds npm updates until a release is three days
    // old, in case a compromised or broken version is unpublished in that
    // time. Packages published by the Publira Organization come from the same
    // maintainers as the repositories that use them, so the wait only delays
    // the rollout of a change that was made for those repositories.
    {
      description: "Raise updates of the Publira Organization's own npm packages as soon as they are published.",
      matchDatasources: ["npm"],
      matchPackageNames: ["@publira/**"],
      minimumReleaseAge: null,
    },
    // Generated code needs a runtime library at least as new as the plugin
    // that generated it. A plugin the registry builds from an npm package
    // would otherwise be raised ahead of that package, which still waits out
    // the three days config:best-practices holds npm updates for. The registry
    // publishes a plugin after the package it is built from, so the same wait
    // counted from the plugin's own release keeps the plugin behind.
    {
      description: "Hold updates of Buf Schema Registry plugins built from npm packages as long as npm updates.",
      matchDatasources: ["custom.buf-plugin"],
      matchPackageNames: ["buf.build/bufbuild/es", "buf.build/connectrpc/es"],
      minimumReleaseAge: "3 days",
    },
    // renovate and lucide-react publish minor releases several times a week,
    // so their minor bumps would otherwise dominate the pull request queue.
    // Only minor updates wait for the weekly window; major and patch updates
    // keep their usual cadence.
    //
    // Without separateMinorPatch, Renovate offers only the newest release within
    // the current major, so a patch for the current minor would be folded into
    // a newer pending minor and wait for the window along with it. The option
    // has to sit in a rule without matchUpdateTypes, because it decides how
    // updates are split before their update type is known.
    {
      matchDatasources: ["npm"],
      matchPackageNames: ["lucide-react", "renovate"],
      separateMinorPatch: true,
    },
    {
      description: "Raise minor updates of renovate and lucide-react once a week (Monday before 04:00).",
      matchDatasources: ["npm"],
      matchPackageNames: ["lucide-react", "renovate"],
      matchUpdateTypes: ["minor"],
      schedule: ["* 0-3 * * 1"],
    },
    // config:best-practices commits an update to `dependencies` as `fix(deps)`
    // whichever package.json declares it, and a branch takes the highest type
    // among its updates. In a repository that releases with release-please, an
    // update reaching a demo or example app alongside the published package
    // therefore cut a release although nothing published changed. A repository
    // whose own private app has another name adds a rule of its own.
    {
      description: "Commit updates of the end-to-end tests and the demo and example apps as chore, since they are never published.",
      matchFileNames: [
        "apps/demo/**",
        "apps/demo-*/**",
        "apps/example/**",
        "apps/example-*/**",
        "e2e/**",
      ],
      semanticCommitType: "chore",
    },
  ],
}
