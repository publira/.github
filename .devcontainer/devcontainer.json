{
  "name": "publira/.github",
  "image": "ghcr.io/publira/base-images/publira-dev:2026.11.06@sha256:f65f2d4ebcb2688c26b9a2c950c21e2758e9c6880b0b89e1d5b473678266d85c",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "mounts": [
    "source=publira-dotgithub-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=publira-dotgithub-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=publira-dotgithub-gemini-${devcontainerId},target=/home/vscode/.gemini,type=volume",
    "source=publira-dotgithub-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=publira-dotgithub-grok-${devcontainerId},target=/home/vscode/.grok,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
